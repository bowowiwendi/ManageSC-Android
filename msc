def _run_tui(stdscr):
    import curses
    curses.curs_set(0)
    stdscr.keypad(True)
    H, W = stdscr.getmaxyx()
    try:
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)
        curses.init_pair(2, curses.COLOR_GREEN, -1)
        curses.init_pair(3, curses.COLOR_YELLOW, -1)
        curses.init_pair(4, curses.COLOR_MAGENTA, -1)
    except Exception:
        pass

    def draw(title, items, sel, banner=False):
        stdscr.erase()
        lines = []
        if banner and H >= 14:
            lines.extend(BANNER)
            lines.append("")
        lines.append(title)
        lines.append("[up/down] pilih  [Enter] jalankan  [q/Esc] kembali")
        block_h = len(lines) + len(items)
        start_y = max(0, (H - block_h) // 2)
        y = start_y
        if banner and H >= 14:
            for line in BANNER:
                try:
                    stdscr.addstr(y, max(0, (W - len(line)) // 2), line, curses.A_BOLD | curses.color_pair(1))
                except Exception:
                    pass
                y += 1
            y += 1
        try:
            stdscr.addstr(y, max(0, (W - len(title)) // 2), title, curses.A_BOLD | curses.color_pair(1)); y += 1
            stdscr.addstr(y, max(0, (W - 60) // 2), "[up/down] pilih  [Enter] jalankan  [q/Esc] kembali", curses.A_DIM); y += 2
        except Exception:
            pass
        for i, (label, _) in enumerate(items):
            x = max(0, (W - len(label)) // 2)
            try:
                style = curses.A_REVERSE | (curses.color_pair(2) if i == sel else 0)
                stdscr.addstr(y + i, x, label, style)
            except Exception:
                pass
        stdscr.refresh()

    def get_text(prompt, y=None):
        curses.echo()
        if y is None:
            y = H - 2
        stdscr.move(y, 0)
        stdscr.clrtoeol()
        stdscr.addstr(y, 0, prompt + ": ")
        stdscr.refresh()
        s = stdscr.getstr().decode("utf-8", "replace").strip()
        curses.noecho()
        return s

    def show_text(title, text):
        lines = text.split("\n")
        top = 0
        while True:
            stdscr.erase()
            try:
                stdscr.addstr(0, max(0, (W - len(title)) // 2), title, curses.A_BOLD | curses.color_pair(1))
                stdscr.addstr(1, 0, "[up/down] scroll  [q/Esc] kembali", curses.A_DIM)
            except Exception:
                pass
            for i in range(2, H - 1):
                idx = top + (i - 2)
                if idx < len(lines):
                    try:
                        stdscr.addstr(i, 0, lines[idx][:W - 1])
                    except Exception:
                        pass
            stdscr.refresh()
            ch = stdscr.getch()
            if ch in (ord("q"), 27):
                break
            elif ch == curses.KEY_DOWN:
                top = min(top + 1, max(0, len(lines) - max(1, H - 3)))
            elif ch == curses.KEY_UP:
                top = max(0, top - 1)

    def menu_loop(title, items, banner=False):
        sel = 0
        while True:
            draw(title, items, sel, banner)
            ch = stdscr.getch()
            if ch == curses.KEY_UP:
                sel = (sel - 1) % len(items)
            elif ch == curses.KEY_DOWN:
                sel = (sel + 1) % len(items)
            elif ch in (10, 13):
                fn = items[sel][1]
                if fn is None:
                    return
                r = fn()
                if isinstance(r, str):
                    show_text(items[sel][0], r)
            elif ch in (ord("q"), 27):
                return

