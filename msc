def table_str(data, color=False):
    if not data:
        return "(kosong)"
    headers = ["ID", "Username", "Tipe", "Masa Aktif", "IP VPS", "Email", "RAM", "SSH"]
    rows = [[it.get("id", "")[:8], it.get("username", ""), it.get("tipeAkun", ""),
             it.get("masaAktif", ""), it.get("ipVps", ""), it.get("emailMember", ""),
             it.get("ram", ""), "on" if it.get("userSsh") else "-"] for it in data]
    widths = [max(len(h), *(len(r[i]) for r in rows)) for i, h in enumerate(headers)]
    lines = [" | ".join(
        c(h.ljust(widths[i]), 1, 96) if color else h.ljust(widths[i]) for i, h in enumerate(headers)),
        "-+-".join("-" * w for w in widths)]
    for r in rows:
        cells = []
        for i, val in enumerate(r):
            if color and i == 7:
                val = c(val.ljust(widths[i]), 32 if val == "on" else 90)
            elif color and i == 1:
                val = c(val.ljust(widths[i]), 1, 97)
            else:
                val = val.ljust(widths[i])
            cells.append(val)
        lines.append(" | ".join(cells))
    return "\n".join(lines)


def print_table(data):
    print(table_str(data, color=USE_COLOR))
    if not data:
        print("(kosong)")
        return
    headers = ["ID", "Username", "Tipe", "Masa Aktif", "IP VPS", "Email", "RAM", "SSH"]
    rows = []
    for it in data:
        rows.append([
            it.get("id", "")[:8],
            it.get("username", ""),
            it.get("tipeAkun", ""),
            it.get("masaAktif", ""),
            it.get("ipVps", ""),
            it.get("emailMember", ""),
            it.get("ram", ""),
            "on" if it.get("userSsh") else "-",
        ])
    widths = [max(len(h), *(len(r[i]) for r in rows)) for i, h in enumerate(headers)]
    line = " | ".join(h.ljust(widths[i]) for i, h in enumerate(headers))
    print(line)
    print("-+-".join("-" * w for w in widths))
    for r in rows:
        print(" | ".join(r[i].ljust(widths[i]) for i in range(len(headers))))


